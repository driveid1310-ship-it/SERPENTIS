# SERPENTIS Server Configuration Example
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/serpentis
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key
JWT_EXPIRES_IN=7d

# CORS Origins (comma-separated, or '*' for development)
CORS_ORIGIN=*

# Password Reset & Email Configuration (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=user@example.com
SMTP_PASSWORD=password
SMTP_FROM="SERPENTIS <no-reply@serpentis.app>"
PASSWORD_RESET_SECRET=replace_with_a_secure_random_reset_secret

# Cloudinary Image Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ==============================================
# Environmental Data Providers (India-First)
# ==============================================

# Open-Meteo (Weather & Modeled Air Quality - Free non-commercial CC BY 4.0)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_AQ_BASE_URL=https://air-quality-api.open-meteo.com/v1
ENVIRONMENTAL_ALLOW_MOCK_FALLBACK=true

# India Meteorological Department (IMD) - Requires static IP + official API registration
# Portal: https://api.imd.gov.in/
IMD_API_BASE_URL=https://api.imd.gov.in
IMD_API_KEY=
IMD_JWT_TOKEN=

# OpenAQ v3 (Ground Air Quality Stations in India) - Free key at https://explore.openaq.org/
OPENAQ_API_BASE_URL=https://api.openaq.org/v3
OPENAQ_API_KEY=

# CPCB / data.gov.in Official AQI Resource API (Optional)
DATA_GOV_IN_API_KEY=
DATA_GOV_IN_AQI_RESOURCE_ID=3b01bcb8-0b14-4abf-b6f2-c1bfd384ba69

# ==============================================
# AI Intelligence Provider (Optional)
# ==============================================
# Supported providers: none | openai | gemini
AI_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
