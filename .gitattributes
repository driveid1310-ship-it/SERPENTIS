# Auto detect text files and perform LF normalization conservatively
* text=auto

# Shell & Gradle Unix wrappers must stay LF
*.sh text eol=lf
mobile/android/gradlew text eol=lf

# Windows batch scripts must stay CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.jar binary
*.keystore binary
*.jks binary
*.apk binary
*.aab binary
*.docx binary
*.pdf binary
*.zip binary
