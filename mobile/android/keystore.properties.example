# Copy to mobile/android/keystore.properties (gitignored) or set SERPENTIS_UPLOAD_* env vars
# Generate an upload keystore using:
#   keytool -genkeypair -v -storetype PKCS12 -keystore serpentis-upload-key.keystore -alias serpentis-upload -keyalg RSA -keysize 2048 -validity 10000

storeFile=serpentis-upload-key.keystore
storePassword=REPLACE_WITH_STORE_PASSWORD
keyAlias=serpentis-upload
keyPassword=REPLACE_WITH_KEY_PASSWORD
